MONGODB_URL=mongodb://localhost:27017/proteindomainfinder
DATABASE_NAME=protein_db
FRONTEND_URL=http://localhost:8501

# Password reset email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# Private demo only: show a one-time reset code in the app when SMTP is not configured.
# Keep this false for public deployments.
PASSWORD_RESET_ALLOW_DEMO_CODE=false

# Admin signup setup code. Set this in deployment, then use it once to create an admin account.
ADMIN_SETUP_CODE=
